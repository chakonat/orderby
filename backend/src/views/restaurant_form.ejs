<%- include('partials/header') %>
<section class="card">
  <div class="card-header">
    <h2><%= restaurant ? 'Редактировать ресторан' : 'Новый ресторан' %></h2>
  </div>
  <form method="post" enctype="multipart/form-data" action="<%= restaurant ? '/admin/restaurants/' + restaurant._id : '/admin/restaurants' %>">
    <div class="grid-2">
      <label>
        Название
        <input name="name" required value="<%= restaurant?.name || '' %>" />
      </label>
      <label>
        Город
        <input name="city" value="<%= restaurant?.city || '' %>" />
      </label>
      <label>
        Кухня
        <input name="cuisine" value="<%= restaurant?.cuisine || '' %>" />
      </label>
      <label>
        Время доставки
        <input name="deliveryTime" value="<%= restaurant?.deliveryTime || '' %>" />
      </label>
      <label>
        Уровень цен (₸₸)
        <input name="priceLevel" value="<%= restaurant?.priceLevel || '' %>" />
      </label>
      <label>
        Рейтинг
        <input name="rating" type="number" step="0.1" value="<%= restaurant?.rating || 4.5 %>" />
      </label>
      <label>
        Мин. заказ
        <input name="minOrder" type="number" value="<%= restaurant?.minOrder || 0 %>" />
      </label>
      <label>
        Доставка
        <input name="deliveryFee" type="number" value="<%= restaurant?.deliveryFee || 0 %>" />
      </label>
    </div>
    <label>
      Описание
      <textarea name="description" rows="3"><%= restaurant?.description || '' %></textarea>
    </label>
    <label>
      Теги (через запятую)
      <input name="tags" value="<%= restaurant?.tags ? restaurant.tags.join(', ') : '' %>" />
    </label>
    <label>
      Картинка
      <input type="file" name="image" accept="image/*" />
    </label>
    <label class="checkbox">
      <input type="checkbox" name="isActive" <%= restaurant?.isActive !== false ? 'checked' : '' %> />
      Активен
    </label>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <div class="actions">
      <button type="submit">Сохранить</button>
      <a class="ghost" href="/admin">Отмена</a>
    </div>
  </form>
</section>
<%- include('partials/footer') %>
